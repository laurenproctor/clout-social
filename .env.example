# Anthropic Claude SDK — used by lib/ai.ts for content/hook generation
ANTHROPIC_API_KEY=

# Vercel AI Gateway — powers Brand Studio image + video generation
# (app/api/brand/*). Authenticates via this key OR a Vercel OIDC token
# (VERCEL_OIDC_TOKEN, auto-injected on Vercel; locally run `vercel env pull`).
# Without either, Brand Studio still renders templated brand graphics but
# skips AI backgrounds and video. Get a key: Vercel dashboard → AI Gateway.
AI_GATEWAY_API_KEY=
# Optional model overrides (see lib/aiAssets.ts for the current defaults).
# BRAND_IMAGE_MODEL=openai/gpt-image-2
# BRAND_VIDEO_MODEL=google/veo-3.1-fast-generate-001

# Zernio multi-channel publishing API — used by lib/zernio.ts
# Sent as: Authorization: Bearer <KEY>
ZERNIO_API_KEY=

# Note: GDELT's DOC 2.0 HTTP API requires no key BUT hard-throttles (429)
# datacenter/serverless IPs (incl. Vercel), so live trend data is fetched from
# GDELT's dataset in Google BigQuery instead (see below). The HTTP path remains
# as a fallback for local dev on a residential IP.

# GDELT via Google BigQuery — powers the live trend refresh (lib/gdeltBigquery.ts,
# app/api/cron/refresh-signals). Query GDELT's public gdelt-bq.gdeltv2 dataset
# with a GCP service account (roles: BigQuery Job User + BigQuery Data Viewer).
# Store the service-account JSON as base64 (robust for env vars):
#   base64 -i service-account.json | pbcopy   # macOS
GCP_SERVICE_ACCOUNT_KEY_BASE64=
# Alternatively paste the raw service-account JSON instead of the base64 form:
# GCP_SERVICE_ACCOUNT_JSON=
# Optional: defaults to the key's project_id. Must be a project with BigQuery
# enabled and a billing account (GDELT queries stay within the 1 TB/mo free tier).
GCP_PROJECT_ID=

# Cron auth for the GDELT background-refresh job (app/api/cron/refresh-signals).
# Vercel Cron automatically sends `Authorization: Bearer <CRON_SECRET>` when set.
# Set this in production so the endpoint can't be triggered by the public. When
# unset (local dev), the refresh endpoint is open so you can hit it by hand.
# Note: the background refresh only surfaces live data when a shared store
# (Supabase, below) is configured — on serverless, in-memory isn't shared
# between the cron and request functions.
CRON_SECRET=

# Vercel Blob — used by app/api/upload/route.ts for image/video attachments.
# Optional in dev (falls back to /public/uploads); required in production so
# uploads return public CDN URLs Zernio can fetch. Provision via:
#   vercel blob  (or the Vercel Marketplace), then `vercel env pull .env.local`
BLOB_READ_WRITE_TOKEN=

# Zernio webhook signing secret — used by app/api/webhooks/zernio/route.ts to
# verify the x-zernio-signature (HMAC-SHA256 of the raw body). Set the same
# value in your Zernio webhook config. If unset, signature checks are skipped (dev only).
ZERNIO_WEBHOOK_SECRET=

# Supabase — durable stores for post tags (analytics provenance) and post status
# (webhooks). Server-only; used by lib/postTagStore.ts & lib/postStatusStore.ts.
# When unset, both stores fall back to in-memory (fine for local dev).
# Run supabase/migrations/0001_stores.sql once to create the tables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk auth (optional). When both are set, the app requires sign-in and shows
# the user menu; when unset, the app runs open with a placeholder avatar.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
